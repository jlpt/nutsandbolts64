diff --git a/include/nbhooks.h b/include/nbhooks.h
new file mode 100644
index 0000000..2b76ea5
--- /dev/null
+++ b/include/nbhooks.h
@@ -0,0 +1,46 @@
+#ifndef __NBHOOKS_H__
+#define __NBHOOKS_H__
+
+/*
+ * Nuts & Bolts 64 mod interface.
+ *
+ * The mod is a separate binary that lives in the Expansion Pak region
+ * (0x80400000) and is DMA'd from ROM offset NB_ROM_OFFSET at boot.
+ * The first bytes of the mod image are an NBHeader with function pointers
+ * the game calls into. The original game's memory map is left untouched.
+ */
+
+#include <ultra64.h>
+
+#define NB_MAGIC        0x4E423634 /* 'NB64' */
+#define NB_ROM_OFFSET   0x01000000
+#define NB_RAM_BASE     0x80400000
+#define NB_HEADER_SIZE  0x40
+
+typedef struct {
+    u32 magic;
+    u32 version;
+    u32 load_size;   /* bytes to DMA (text + data), multiple of 8 */
+    u8 *bss_start;
+    u8 *bss_end;
+    void (*init)(void);
+    void (*update)(void);
+    void (*draw_world)(Gfx **gfx, Mtx **mtx, Vtx **vtx);
+    void (*draw_hud)(Gfx **gfx, Mtx **mtx, Vtx **vtx);
+    s32  (*block_pause)(void);
+    void (*map_unload)(void);
+    u32 pad[5];
+} NBHeader;
+
+#define NB_HEADER ((NBHeader *)NB_RAM_BASE)
+
+extern s32 gNBLoaded;
+
+void nbhook_load(void);
+void nbhook_update(void);
+void nbhook_drawWorld(Gfx **gfx, Mtx **mtx, Vtx **vtx);
+void nbhook_drawHud(Gfx **gfx, Mtx **mtx, Vtx **vtx);
+s32  nbhook_blockPause(void);
+void nbhook_mapUnload(void);
+
+#endif
