 }
 
 void func_8023DBAC(void) {
@@ -160,6 +166,7 @@ void core1_init(void) {
     audioManager_init();
     graphicsCache_init();
     ml_init();
+    nbhook_load();
     gctransition_reset();
     D_8027A130 = 0;
     gGlobalTimer = 0;
@@ -291,3 +298,49 @@ OSThread *mainThread_get(void) {
 void disableInput_set(void) {
     sDisableInput = TRUE;
 }
+
+/* Nuts & Bolts 64: load the mod image from ROM into Expansion Pak RAM. */
+s32 gNBLoaded = FALSE;
+
+void nbhook_load(void) {
+    NBHeader *hdr = NB_HEADER;
+
+    gNBLoaded = FALSE;
+    if (osMemSize < 0x800000) {
+        return; /* no Expansion Pak, the mod stays disabled */
+    }
+    parallel_readDMA(hdr, NB_ROM_OFFSET, NB_HEADER_SIZE);
+    osInvalDCache(hdr, NB_HEADER_SIZE);
+    if (hdr->magic != NB_MAGIC || hdr->load_size < NB_HEADER_SIZE || hdr->load_size > 0x300000) {
+        return;
+    }
+    parallel_readDMA(hdr, NB_ROM_OFFSET, hdr->load_size);
+    osInvalDCache(hdr, hdr->load_size);
+    osInvalICache(hdr, hdr->load_size);
+    if (hdr->bss_end > hdr->bss_start) {
+        bzero(hdr->bss_start, hdr->bss_end - hdr->bss_start);
+        osWritebackDCache(hdr->bss_start, hdr->bss_end - hdr->bss_start);
+    }
+    gNBLoaded = TRUE;
+    hdr->init();
+}
+
+void nbhook_update(void) {
+    if (gNBLoaded) NB_HEADER->update();
+}
+
+void nbhook_drawWorld(Gfx **gfx, Mtx **mtx, Vtx **vtx) {
+    if (gNBLoaded) NB_HEADER->draw_world(gfx, mtx, vtx);
+}
+
+void nbhook_drawHud(Gfx **gfx, Mtx **mtx, Vtx **vtx) {
+    if (gNBLoaded) NB_HEADER->draw_hud(gfx, mtx, vtx);
+}
+
+s32 nbhook_blockPause(void) {
+    return gNBLoaded ? NB_HEADER->block_pause() : FALSE;
+}
+
+void nbhook_mapUnload(void) {
+    if (gNBLoaded) NB_HEADER->map_unload();
+}
